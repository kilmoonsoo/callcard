<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:colorPrimary">@color/navy</item>
        <item name="android:colorPrimaryDark">@color/navy</item>
        <item name="android:colorAccent">@color/navy</item>
        <item name="android:colorControlActivated">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:textAppearanceButton">@style/TextButton</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:colorAccent">@color/navy</item>
        <item name="android:textAppearanceButton">@style/TextButton</item>
    </style>

    <style name="TextButton">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 글자 -->
    <style name="H1">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_1</item>
    </style>
    <style name="Label">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- 카드 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- 버튼 -->
    <style name="Btn">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Btn.Mint">
        <item name="android:background">@drawable/btn_mint</item>
        <item name="android:textColor">@color/navy</item>
    </style>
    <style name="Btn.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/navy</item>
    </style>
    <style name="Btn.Small">
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:textColor">@color/tab_text</item>
    </style>
</resources>
