<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 버전·업데이트 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tvVersion" style="@style/Hint" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnUpdate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="업데이트 확인" />
        </LinearLayout>

        <!-- 권한 -->
        <TextView android:id="@+id/permStatus" style="@style/Body"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnPerm" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="권한 허용" />
            <Button android:id="@+id/btnBattery" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="배터리 최적화 제외" />
        </LinearLayout>

        <Switch android:id="@+id/swEnabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="명함 발송 사용" android:textSize="18sp" android:textStyle="bold" />

        <!-- 명함 -->
        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="명함 이미지" />
        <ImageView android:id="@+id/imgCard" android:layout_width="match_parent"
            android:layout_height="180dp" android:background="#F2F2F2"
            android:scaleType="fitCenter" android:contentDescription="명함 미리보기" />
        <Button android:id="@+id/btnPick" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="명함 이미지 선택" />

        <Button android:id="@+id/btnTemplate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="✨ 예시 문구 자동 생성" />
        <TextView style="@style/Hint" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회사명·이름·연락처를 넣으면 제목, 소개글, 부재중 문구를 채워 줍니다. 만든 뒤 자유롭게 고치세요." />

        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="제목" />
        <EditText android:id="@+id/etSubject" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" android:maxLength="40" />

        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="소개글" />
        <EditText android:id="@+id/etIntro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="top"
            android:hint="안녕하세요, ○○회사 ○○팀 홍길동입니다. 통화 감사합니다…"
            android:inputType="textMultiLine" android:minLines="4" android:maxLength="1000" />

        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="부재중 전화용 소개글" />
        <EditText android:id="@+id/etMissedIntro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="top"
            android:hint="안녕하세요, ○○회사 홍길동입니다. 전화를 받지 못해 죄송합니다. 확인 후 바로 연락드리겠습니다."
            android:inputType="textMultiLine" android:minLines="3" android:maxLength="1000" />
        <TextView style="@style/Hint" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="비워두면 위의 소개글을 그대로 보냅니다. 명함 이미지는 같이 보냅니다." />

        <!-- 발송 조건 -->
        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="언제 보낼까요" />
        <CheckBox android:id="@+id/cbAnswered" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="받은 전화 종료 후" />
        <CheckBox android:id="@+id/cbMissed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="부재중 전화" />
        <CheckBox android:id="@+id/cbMobile" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="휴대폰 번호(010 등)에만 보내기" />
        <TextView style="@style/Hint" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="같은 번호에는 하루에 한 번만 보냅니다." />

        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="발송 방식" />
        <RadioGroup android:id="@+id/rgMode" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbConfirm" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="보내기 전에 알림으로 확인" />
            <RadioButton android:id="@+id/rbAuto" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="확인 없이 자동 발송" />
        </RadioGroup>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="저장" />

        <!-- 테스트 -->
        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="테스트 발송 (내 번호 등)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/etTest" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="01012345678"
                android:inputType="phone" />
            <Button android:id="@+id/btnTest" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="기본" />
            <Button android:id="@+id/btnTestMissed" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="부재중" />
        </LinearLayout>

        <TextView style="@style/Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="최근 기록" />
        <TextView android:id="@+id/tvLog" style="@style/Hint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
